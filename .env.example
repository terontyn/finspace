PROJECT_NAME=Finspace
ENVIRONMENT=development
TESTING=false
DEBUG=true

POSTGRES_DB=finspace
POSTGRES_TEST_DB=finspace_test
POSTGRES_USER=finspace
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+asyncpg://finspace:change_me@postgres:5432/finspace
TEST_DATABASE_URL=postgresql+asyncpg://finspace:change_me@postgres:5432/finspace_test
TEST_REDIS_URL=redis://redis:6379/15
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change_me_with_long_random_value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_NAME=finspace_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
ALLOW_REGISTRATION=true
ALLOW_DEV_AUTH_HEADERS=false

IMPORT_MAX_FILE_SIZE_MB=20
IMPORT_MAX_ROWS=100000
IMPORT_ALLOWED_EXTENSIONS=csv,xlsx
IMPORT_STORAGE_PATH=/app/data/imports

BACKUP_STORAGE_PATH=/backups/database
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_REMOTE_PROVIDER=disabled
BACKUP_SECONDARY_PATH=
BACKUP_REMOTE_AFTER_VERIFY=true
BACKUP_STALE_HOURS=36

GOOGLE_SYNC_PROVIDER=apps_script_bridge
GOOGLE_OAUTH_ENABLED=false
APPS_SCRIPT_BRIDGE_ENABLED=true
PUBLIC_BACKEND_URL=
APPS_SCRIPT_PULL_BATCH_SIZE=100
APPS_SCRIPT_HEARTBEAT_TTL_MINUTES=15

# Необязательный provider Google Cloud OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_OAUTH_SCOPES=openid,email,profile,https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/drive.file
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_TOKEN_ENCRYPTION_KEY_VERSION=1
GOOGLE_SHEETS_SYNC_ENABLED=true
GOOGLE_SHEETS_WORKER_BATCH_SIZE=100
GOOGLE_SHEETS_WORKER_POLL_SECONDS=5
GOOGLE_SHEETS_MAX_RETRY_ATTEMPTS=8
GOOGLE_SHEETS_WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300
GOOGLE_SHEETS_TEMPLATE_VERSION=1
PUBLIC_WEBHOOK_BASE_URL=

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_VERSION=0.1.0

NEXT_PUBLIC_API_URL=/local-api
INTERNAL_API_URL=http://backend:8000

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=change_me_with_long_random_value
N8N_TIMEZONE=Europe/Amsterdam
N8N_EXECUTIONS_DATA_PRUNE=true
N8N_EXECUTIONS_DATA_MAX_AGE_HOURS=336
N8N_LOG_LEVEL=info
N8N_HEARTBEAT_STALE_MINUTES=15
FINSPACE_N8N_BACKEND_URL=http://backend:8000
